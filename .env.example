# OpenCode Bridge Configuration
# Copy this to /tmp/owpenbot/.env and edit for your setup

# URL of the opencode serve instance
OPENCODE_URL=http://127.0.0.1:4096

# Working directory for opencode sessions
OPENCODE_DIRECTORY=/path/to/your/workspace

# owpenbot data directory (stores DB, logs, credentials)
OWPENBOT_DATA_DIR=~/.owpenbot

# WhatsApp auth directory (session credentials persist here)
WHATSAPP_AUTH_DIR=~/.owpenbot/credentials/whatsapp

# Enable WhatsApp adapter
WHATSAPP_ENABLED=true

# CRITICAL: Must be true for self-messages (messages to your own number) to work.
# .env values override owpenbot.json config.
WHATSAPP_SELF_CHAT=true

# Message trigger prefix — only messages starting with this are processed.
# Default: ~
WHATSAPP_TRIGGER_PREFIX=~

# Reply prefix — prepended to all LLM responses sent back to WhatsApp.
# Default: [🤖 AI]:
WHATSAPP_REPLY_PREFIX=[🤖 AI]:

# Suppress error replies — when true, LLM failures are logged but never sent to WhatsApp.
# Default: true
WHATSAPP_SUPPRESS_ERRORS=true

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Optional: password for opencode serve API
# If your server listens beyond localhost, set this.
# OPENCODE_SERVER_PASSWORD=your_secret
